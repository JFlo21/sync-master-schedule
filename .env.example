SMARTSHEET_API_KEY=your_api_key_here
TEMP_DOWNLOAD_FOLDER=/tmp/smartsheet-attachments
# Routing is pinned in code (src/config.py VERIFIED_ROUTES) and is not configurable here.
# Two routes run in this order, both from Project List (match column "Work Request #"):
#   1. master-schedule: all file attachments -> Master Schedule (4850043816202116, match column "WR")
#   2. blank-copy:      PDF files only       -> Project List - Blank Copy (573385022328708, match column "Work Request #")
# SOURCE_SHEET_ID, TARGET_SHEET_ID, SOURCE_MATCH_COLUMN_ID and TARGET_MATCH_COLUMN_ID
# are ignored if set (the job logs a warning); do not add them.
